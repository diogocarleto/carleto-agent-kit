{
  "chat.useClaudeMdFile": false,
  "chat.useAgentsMdFile": false,
  "chat.tools.terminal.autoApprove": {
    "mvn": true,
    "jshell": true,
    "npm": true,
    "pnpm": true,
    "yarn": true,
    "go": true,
    "cargo": true,
    "uv": true,
    "pytest": true,
    "dotnet": true,
    "mongosh": true,
    "node .agent-kit/ui/detect.mjs": true,
    "node .agent-kit/planning/plan-lint.mjs": true,
    "ls": true,
    "cat": true,
    "echo": true,
    "grep": true,
    "rg": true,
    "find": true,
    "head": true,
    "tail": true,
    "wc": true,
    "sed -n": true,
    "javap": true,
    "jar tf": true,
    "unzip -l": true,
    "unzip -p": true,
    "xmllint": true,
    "git status": true,
    "git diff": true,
    "git log": true,
    "git show": true,
    "git rev-parse": true,
    "git rev-list": true,
    "git branch": true,
    "git ls-tree": true,
    "git check-ignore": true,
    "git stash list": true,
    "git add": true,
    "git commit": true,
    "git tag": true,
    "git mv": true,
    "git restore": true,
    "docker info": true,
    "docker version": true,
    "docker wait": true,
    "codex exec": true,
    "claude -p": true,
    "/\\brm\\s+-[a-z]*[rf]/": { "approve": false, "matchCommandLine": true },
    "/\\bgit\\s+push\\b.*--force/": { "approve": false, "matchCommandLine": true },
    "/\\bgit\\s+reset\\s+--hard/": { "approve": false, "matchCommandLine": true },
    "/\\bgit\\s+clean/": { "approve": false, "matchCommandLine": true },
    "/\\bsed\\s+-i\\b/": { "approve": false, "matchCommandLine": true },
    "/\\bperl\\s+-i\\b/": { "approve": false, "matchCommandLine": true }
  }
}
